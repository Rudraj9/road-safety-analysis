# Virtual environments
.venv/
venv/
env/
ENV/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables
.env
.env.*
!.env.example

# Local datasets and annotations
data/raw/videos/*
!data/raw/videos/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.mp4
*.avi
*.mov
*.mkv

# Model weights
models/pretrained/*
!models/pretrained/.gitkeep
*.pt
*.pth
*.onnx
*.engine

# Generated outputs
outputs/videos/*
!outputs/videos/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep

